{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zihin",
  "version": "../package.json",
  "identifier": "com.keyboardwatcher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zihin",
        "width": 980,
        "height": 660,
        "minWidth": 780,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Enes Bilik",
    "copyright": "© 2026 Enes Bilik",
    "category": "Utility",
    "shortDescription": "Tag yaz, tuşa bas, değeri gelsin",
    "longDescription": "Zihin, sık kullandığın parola, e-posta ve IP gibi metinleri bir tag'e bağlar. Herhangi bir uygulamada ;tag yazıp TAB'a basınca değer otomatik yazılır.",
    "homepage": "https://github.com/bilikenes/zihin",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRTQ2M0UyNEI2NDNFNDIKUldSQ1BtUkw0bVBra2dYZk1JamVlM0tmNW9pK2J0UitpcndnR3ZVOHZhR3Z1ZHdLeGZFQkxIQ2gK",
      "endpoints": [
        "https://github.com/bilikenes/zihin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
